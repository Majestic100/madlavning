---
/** Om-siden — en rigtig side med historie (spec §8) + Person JSON-LD (E-E-A-T, spec §7). */
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { personJsonLd, breadcrumbJsonLd } from "../lib/jsonld";
import { forfatter } from "../data/forfattere";
import { sti } from "../lib/urls";

const merve = forfatter("merve");
const portraet = await getImage({ src: merve.portraet, width: 920, height: 920, fit: "cover", format: "jpg" });
const jsonld = [
  personJsonLd(merve, Astro.site!.href, portraet.src),
  breadcrumbJsonLd([{ navn: "Forside", url: sti("/") }, { navn: "Om Merve", url: null }], Astro.site!.href),
];
---
<Layout titel="Om Merve Holck, kvinden bag opskrifterne" beskrivelse="Mød Merve Holck, kvinden bag opskrifterne. Om passionen for bagning, der startede i køkkenet med min mor, og en KÆMPE sød tand." aktiv="om" jsonld={jsonld}>
  <div class="side-top">
    <div class="wrap-laes">
      <p class="oejenbryn">Merve Holck</p>
      <h1>Om mig</h1>
      <div class="intro">
        <p>Jeg hedder Merve, og her kan du læse lidt mere om hvem jeg er.</p>
      </div>
    </div>
  </div>

  <div class="wrap-laes o-intro" style="padding-bottom:1rem">
    <figure class="o-hero" style="max-width:380px">
      <Image src={merve.portraet} alt={`Portræt af ${merve.navn}`} widths={[380, 760]}
             sizes="(max-width: 480px) 94vw, 380px" width={760} height={760} fit="cover" loading="eager"
             style="aspect-ratio: 1 / 1" />
    </figure>

    <p>
      Min store passion for bagning startede da jeg som barn var med min mor i køkkenet. Jeg elskede at
      se hvordan min mor freestylede sig til alting, og det blev jeg virkelig inspireret af. Jeg hjalp
      med at bage, så meget som jeg kunne, og jeg elskede når vi brugte en hel dag på at bage sammen.
    </p>
    <p>
      I mine teenageår var særligt fondant kager en kæmpe passion, og jeg lavede tonsvis til venner og
      bekendte. Jeg elskede det kreative i at designe kagerne og pynte dem super flot. Dog har smagen af
      fondant aldrig været mig.
    </p>
    <p>
      Og netop det kreative hænger stadig ved den dag i dag. Jeg arbejder nemlig som content creator, hvor
      jeg netop får lov til at være kreativ hver dag.
    </p>
    <p>
      Da jeg blev mor i 2021 begyndte jeg at gå rigtig meget op i at bage så meget som muligt til min søn,
      så han ikke fik en masse e-numre i hans lille krop. Jeg testede en masse opskrifter af, og bager den
      dag i dag også en masse til madpakkerne til hele børneflokken, som består af tre nu.
    </p>
    <p>
      Jeg har en KÆMPE sød tand, og har næsten ikke en stopklods, når det kommer til søde sager. Jeg kan
      sagtens spise kage eller slik før kl. 8 om morgenen (helt uden at skamme mig), og jeg kommer aldrig
      til at forstå hvorfor dessert skal være sidste måltid i en tre-retters menu.
    </p>
    <p>
      Jeg håber, at du kan li’ mine opskrifter. Tøv endelig ikke med at <a href={sti("/kontakt/")}>skrive</a>,
      hvis du har spørgsmål, finder stavefejl eller noget der ikke giver mening.
    </p>
  </div>

</Layout>

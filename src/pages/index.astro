---
/** Forside — maks 5 sektioner (spec §6). */
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Ikon from "../components/Ikon.astro";
import OpskriftKort from "../components/OpskriftKort.astro";
import InstagramSektion from "../components/InstagramSektion.astro";
import HeroKarussel from "../components/HeroKarussel.astro";
import { TIDS_INTERVALLER, aktivTid, tidsInterval } from "../lib/tid.mjs";
import { sti } from "../lib/urls";
import { SITE } from "../data/site";

const alle = (await getCollection("opskrifter")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

/* Heroens karussel: sæsonens opskrifter først (`seasonal: true` i frontmatter, spec §6),
   derefter de nyeste. "Nyeste opskrifter" viser kun dem, der ikke allerede er i karussellen. */
const karussel = [...alle.filter((o) => o.data.seasonal), ...alle.filter((o) => !o.data.seasonal)].slice(0, 10);
const nyeste = alle.filter((o) => !karussel.includes(o)).slice(0, 8);

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.navn,
  url: Astro.site!.href,
  inLanguage: "da-DK",
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: new URL(sti("/soeg/"), Astro.site).href + "?q={search_term_string}" },
    "query-input": "required name=search_term_string",
  },
};

const tidTal = new Map(TIDS_INTERVALLER.map((i) => [i.id, 0]));
for (const o of alle) {
  const i = tidsInterval(aktivTid(o.data));
  tidTal.set(i.id, (tidTal.get(i.id) ?? 0) + 1);
}
---
<Layout aktiv="forside" jsonld={[websiteJsonLd]}>

  <!-- 1: Søgning og opskriftskarussel -->
  <HeroKarussel
    titel="Merve: opskrifter der virker. Også første gang"
    soegSti={sti("/soeg/")}
    antal={alle.length}
    opskrifter={karussel}
  />

  <!-- 2: Nyeste opskrifter -->
  <section class="sektion">
    <div class="wrap">
      <div class="sektion-hoved">
        <div>
          <p class="oejenbryn">Lige ud af ovnen</p>
          <h2>Nyeste opskrifter</h2>
        </div>
        <a class="se-alle" href={sti("/opskrifter/")}>Se alle <Ikon navn="pil" /></a>
      </div>
      <ul class="kort-net">
        {nyeste.map((o) => <OpskriftKort post={o} />)}
      </ul>
    </div>
  </section>

  <!-- 3: Tidsbaserede indgange -->
  <section class="sektion sektion-flade">
    <div class="wrap">
      <div class="sektion-hoved">
        <div>
          <p class="oejenbryn">Hvor lang tid har du?</p>
          <h2>Vælg efter aktiv tid</h2>
          <p>Tiden, du reelt står i køkkenet. Hævetid og køletid passer sig selv.</p>
        </div>
      </div>
      <div class="tids-net">
        {TIDS_INTERVALLER.filter((i) => (tidTal.get(i.id) ?? 0) > 0).map((i) => (
          <a class="tids-flise" href={`${sti("/opskrifter/")}?tid=${i.id}`}>
            <strong>{i.label}</strong>
            <span>{tidTal.get(i.id)} {tidTal.get(i.id) === 1 ? "opskrift" : "opskrifter"}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4: Instagram -->
  <section class="sektion">
    <div class="wrap">
      <InstagramSektion />
    </div>
  </section>

</Layout>

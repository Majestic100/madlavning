---
/**
 * Alt under /opskrifter/ (spec §7-URL-struktur):
 *   /opskrifter/               → alle opskrifter (side 1)
 *   /opskrifter/side/2/        → alle opskrifter (side 2+)
 *   /opskrifter/kager/         → kategoriside
 *   /opskrifter/kager/side/2/  → kategoriside (side 2+)
 *   /opskrifter/kager/cookies/ → underkategoriside
 *   /opskrifter/kanelsnurrer/  → opskriftsside
 */
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import OpskriftSide from "../../components/sider/OpskriftSide.astro";
import KategoriListe from "../../components/sider/KategoriListe.astro";
import { KATEGORIER, UNDERKATEGORIER, underkategorierAf, underkategoriAf, type Kategori, type Underkategori } from "../../lib/kategorier";

export const PR_SIDE = 12;

export async function getStaticPaths() {
  const alle = (await getCollection("opskrifter")).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );

  const reserverede = new Set([...KATEGORIER.map((k) => k.slug), "side"]);
  for (const o of alle) {
    if (reserverede.has(o.id)) {
      throw new Error(`Opskrift-slug "${o.id}" kolliderer med en kategori-URL. Omdøb filen.`);
    }
    const sub = o.data.subcategory;
    if (sub && !underkategoriAf(o.data.category, sub)) {
      const muligheder = underkategorierAf(o.data.category).map((u) => u.slug).join(", ") || "ingen";
      throw new Error(`Opskriften "${o.id}" har ukendt subcategory "${sub}". Mulige for ${o.data.category}: ${muligheder}.`);
    }
  }
  if (UNDERKATEGORIER.some((u) => u.slug === "side")) throw new Error('Underkategorien må ikke hedde "side".');

  type Sti = { params: { slug: string | undefined }; props: Record<string, unknown> };
  const stier: Sti[] = alle.map((post) => ({
    params: { slug: post.id },
    props: { visning: "opskrift", post },
  }));

  const listeStier = (
    posts: typeof alle,
    kategori: Kategori | null,
    base: string,
    underkategori: Underkategori | null = null,
  ) => {
    const antalSider = Math.max(1, Math.ceil(posts.length / PR_SIDE));
    for (let side = 1; side <= antalSider; side++) {
      const prefix = kategori ? [kategori.slug, underkategori?.slug].filter(Boolean).join("/") : "";
      const slug =
        side === 1
          ? prefix || undefined
          : [prefix, "side", String(side)].filter(Boolean).join("/");
      stier.push({
        params: { slug },
        props: {
          visning: "liste",
          kategori,
          underkategori,
          posts: posts.slice((side - 1) * PR_SIDE, side * PR_SIDE),
          allePosts: posts,
          side,
          antalSider,
          basePath: base,
        },
      });
    }
  };

  listeStier(alle, null, "/opskrifter/");
  for (const kat of KATEGORIER.filter((k) => !k.erArtikler)) {
    const iKategori = alle.filter((o) => o.data.category === kat.slug);
    listeStier(iKategori, kat, `/opskrifter/${kat.slug}/`);
    for (const u of underkategorierAf(kat.slug)) {
      listeStier(iKategori.filter((o) => o.data.subcategory === u.slug), kat, `/opskrifter/${kat.slug}/${u.slug}/`, u);
    }
  }

  return stier;
}

type Props =
  | { visning: "opskrift"; post: CollectionEntry<"opskrifter"> }
  | {
      visning: "liste";
      kategori: Kategori | null;
      underkategori: Underkategori | null;
      posts: CollectionEntry<"opskrifter">[];
      allePosts: CollectionEntry<"opskrifter">[];
      side: number;
      antalSider: number;
      basePath: string;
    };

const props = Astro.props as Props;
import { KATEGORITEKSTER } from "../../data/kategoritekster";
import { sti } from "../../lib/urls";

const listeMeta =
  props.visning === "liste"
    ? {
        titel: props.underkategori?.navn ?? (props.kategori ? props.kategori.navn : "Alle opskrifter"),
        beskrivelse: props.underkategori
          ? `${props.underkategori.navn} fra ${props.kategori!.navn.toLowerCase()}: ${props.underkategori.beskrivelse}`.slice(0, 155)
          : props.kategori
          ? `${props.kategori.tagline}. ${KATEGORITEKSTER[props.kategori.slug].intro[0]}`.slice(0, 155)
          : "Alle Merves opskrifter samlet ét sted: bagværk, kager, desserter, snacks og pizza. Gennemtestede og skrevet i gram.",
      }
    : null;
---
{props.visning === "opskrift" ? (
  <OpskriftSide post={props.post} />
) : (
  <KategoriListe
    kategori={props.kategori}
    underkategori={props.underkategori}
    titel={listeMeta!.titel}
    beskrivelse={listeMeta!.beskrivelse}
    posts={props.posts}
    allePosts={props.allePosts}
    side={props.side}
    antalSider={props.antalSider}
    basePath={sti(props.basePath)}
    seoTitel={props.kategori ? undefined : "Alle opskrifter på bagværk, kager, desserter og pizza"}
  />
)}

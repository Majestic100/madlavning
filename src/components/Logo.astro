---
/** Merves logo (PNG med gennemsigtig baggrund). Bruges i header og footer. */
import { Image } from "astro:assets";
import logo from "../assets/img/logo.png";

interface Props { hoejde?: number }
const { hoejde = 56 } = Astro.props;
const bredde = Math.round((logo.width / logo.height) * hoejde);
---
<Image src={logo} alt="Merve" height={hoejde} width={bredde} densities={[1, 2, 3]} loading="eager" decoding="async" />

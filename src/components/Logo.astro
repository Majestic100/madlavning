---
/**
 * Midlertidigt SVG-ordmærke i brandfarverne.
 * Når det rigtige logo (PNG/SVG) lægges i src/assets/img/, kan dette
 * komponent skiftes til et <Image>-kald — se README.
 */
---
<svg viewBox="0 0 300 92" role="img" aria-label="Merve" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="floede" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFDF8"/><stop offset="1" stop-color="#EFE3D2"/>
    </linearGradient>
  </defs>
  <g stroke="#AB978E" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M46 30 C 40 44, 34 58, 27 71" stroke-width="2.2"/>
    <path d="M55 33 C 52 47, 47 61, 40 74" stroke-width="2.2"/>
    <path d="M63 38 C 62 51, 58 64, 51 76" stroke-width="2.2"/>
    <path d="M44 28 C 58 24, 68 32, 70 45" stroke-width="2.2"/>
    <path d="M30 74 L 20 88" stroke-width="8"/>
  </g>
  <path d="M44 30 C 36 26, 34 16, 42 12 C 48 9, 56 12, 56 19 C 62 17, 68 21, 66 28 C 64 35, 54 37, 47 33 Z"
        fill="url(#floede)" stroke="#C9B7A8" stroke-width="1.6" stroke-linejoin="round"/>
  <text x="86" y="70" font-family="'Grand Hotel', 'Brush Script MT', cursive" font-size="64" fill="#AB978E">Merve</text>
</svg>

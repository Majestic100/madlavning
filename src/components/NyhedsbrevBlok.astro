---
/** Nyhedsbrev med konkret løfte (spec §3/§6). action-URL sættes i src/data/site.ts. */
import { SITE } from "../data/site";
---
<div class="baand">
  <div>
    <p class="oejenbryn">Nyhedsbrev</p>
    <h2>En ny opskrift hver lørdag</h2>
    <p>{SITE.nyhedsbrevLoefte} Jeg skriver også, hvad der gik galt undervejs. Det er tit dér, man lærer mest.</p>
  </div>
  <div>
    <form method="post" action={SITE.nyhedsbrevAction || undefined} data-nyhedsbrev data-klar={SITE.nyhedsbrevAction ? "ja" : "nej"}>
      <label class="sr-only" for="nb-email">Din e-mailadresse</label>
      <input type="email" id="nb-email" name="email" placeholder="din@mail.dk" required autocomplete="email" />
      <button class="knap knap-primaer" type="submit">Tilmeld mig</button>
    </form>
    <small>Du bekræfter tilmeldingen i din indbakke og kan afmelde med ét klik.</small>
  </div>
</div>

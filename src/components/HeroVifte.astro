---
/**
 * Centreret hero med overskrift, tekst, knapper og en vifte af tre billeder.
 * Designet efter 21st.dev "Hero 10", men bygget i Astro og CSS uden React,
 * så forsiden ikke skal hente JavaScript. Animationen er ren CSS og slås fra
 * ved prefers-reduced-motion.
 */
import { Image } from "astro:assets";
import Ikon from "./Ikon.astro";

interface Knap {
  tekst: string;
  link: string;
}

interface Props {
  titel: string;
  titelLinje2Praefiks?: string;
  titelFremhaevet?: string;
  beskrivelse: string;
  socialtBevis?: string;
  /** Højst 3 billeder. Det midterste er størst og hentes med høj prioritet (LCP). */
  billeder: { src: ImageMetadata; alt: string }[];
  primaer: Knap;
  sekundaer?: Knap;
}

const { titel, titelLinje2Praefiks, titelFremhaevet, beskrivelse, socialtBevis, billeder, primaer, sekundaer } =
  Astro.props;
---
<section class="hero-vifte">
  <div class="wrap hero-vifte-indhold">
    <div class="hero-vifte-hoved">
      <h1>
        {titel}
        {(titelLinje2Praefiks || titelFremhaevet) && (
          <>
            <br />
            {titelLinje2Praefiks && <span>{titelLinje2Praefiks} </span>}
            {titelFremhaevet && <span class="hero-vifte-fremhaevet">{titelFremhaevet}</span>}
          </>
        )}
      </h1>
      <p class="hero-vifte-tekst">{beskrivelse}</p>
    </div>

    <div class="hero-vifte-handling">
      <div class="hero-vifte-knapper">
        <a class="knap knap-primaer" href={primaer.link}>{primaer.tekst} <Ikon navn="pil" /></a>
        {sekundaer && <a class="knap knap-linje" href={sekundaer.link}>{sekundaer.tekst}</a>}
      </div>
      {socialtBevis && <p class="hero-vifte-bevis">{socialtBevis}</p>}
    </div>

    <div class="vifte">
      {billeder.slice(0, 3).map((b, i) => (
        <div class={`vifte-kort vifte-kort-${i}`}>
          <Image src={b.src} alt={b.alt} widths={[240, 360, 480, 640]}
                 sizes="(max-width: 640px) 42vw, 320px" width={640} height={800} fit="cover"
                 loading="eager" fetchpriority={i === 1 ? "high" : undefined} decoding="async" />
        </div>
      ))}
    </div>
  </div>
</section>
